{
    "version": "0.2.0",
    "configurations": [
        {
            // Recommended: let cortex-debug manage OpenOCD itself.
            // NOTE: do NOT start OpenOCD manually for this config (port 3333 conflict).
            "name": "Debug Pico-OS for RP2040",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",

            "executable": "${workspaceFolder}/output/kernel.elf",
            "preLaunchTask": "Pico-OS: Build Debug",

            "servertype": "openocd",
            "interface": "swd",
            "device": "RP2040",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/rp2040.cfg"
            ],
            "openOCDLaunchCommands": [
                "gdb_memory_map disable"
            ],

            "gdbPath": "arm-none-eabi-gdb",
            "runToEntryPoint": "entry",

            "liveWatch": {
                "enabled": false
            },

            "svdFile": "${workspaceFolder}/specs/RP2040.svd",
            "showDevDebugOutput": "none"
        }
    ]
}