{
    "version": "0.2.0",
    "configurations": [
        {
            // Build Debug and BOOTSEL-flash the matching output/firmware.uf2.
            "name": "Debug Pico-OS for RP2040",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",

            "executable": "${workspaceFolder}/output/firmware.elf",
            // Add user image symbol files here when debugging a build that links custom user images.
            "symbolFiles": [
                "${workspaceFolder}/output/symbols/firmware.symbols.elf"
            ],

            "servertype": "openocd",
            "interface": "swd",
            "device": "RP2040",
            "configFiles": [
                "interface/cmsis-dap.cfg",
                "target/rp2040.cfg"
            ],
            "loadFiles": [],
            "openOCDPreConfigLaunchCommands": [
                "set USE_CORE 0"
            ],
            "openOCDLaunchCommands": [
                "gdb_memory_map disable",
                "gdb_breakpoint_override hard"
            ],

            "gdbPath": "arm-none-eabi-gdb",
            "runToEntryPoint": "entry",

            "preLaunchCommands": [
                "exec-file \"${workspaceFolder}/output/firmware.elf\""
            ],
            "postLaunchCommands": [],

            "liveWatch": {
                "enabled": false
            },

            "svdFile": "${workspaceFolder}/specs/RP2040.svd",
            "showDevDebugOutput": "none"
        }
    ]
}
