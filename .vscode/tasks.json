{
    "version": "2.0.0",
    "options": {
        "cwd": "${workspaceFolder}"
    },
    "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
    },
    "problemMatcher": ["$rustc"],
    "tasks": [
        {
            "label": "Pico-OS: Build Debug",
            "type": "process",
            "command": "bash",
            "args": ["${workspaceFolder}/tools/build.sh", "dev"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Pico-OS: Build Release",
            "type": "process",
            "command": "bash",
            "args": ["${workspaceFolder}/tools/build.sh", "release"],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "Pico-OS: Clean",
            "type": "process",
            "command": "bash",
            "args": ["${workspaceFolder}/tools/build.sh", "clean"],
            "problemMatcher": []
        }
    ]
}
