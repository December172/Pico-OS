{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Pico-OS: Build Debug",
            "type": "shell",
            "command": "./build.sh clean && ./build.sh dev",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": [
                "$rustc"
            ]
        },
        {
            "label": "Pico-OS: Build Release",
            "type": "shell",
            "command": "./build.sh clean && ./build.sh release",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": [
                "$rustc"
            ]
        },
    ]
}
